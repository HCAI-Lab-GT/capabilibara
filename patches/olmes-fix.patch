+"""Official-repository CyberMetric-500 task for Probe."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import Mapping
+
+from oe_eval.tasks.oe_eval_tasks.sealed_multiple_choice import (
+    SealedMultipleChoiceTask,
+    ProbeTaskError,
+    parse_probe_json,
+)
+
+
+class CyberMetricMC(SealedMultipleChoiceTask):
+    TASK_CONFIG_DEFAULTS = {
+        **SealedMultipleChoiceTask.TASK_CONFIG_DEFAULTS,
+        "dataset_path": "cybermetric/CyberMetric",
+        "dataset_name": "CyberMetric-500-v1.json",
+        "revision": "294662b03be73a9c7c73918f687882c1ba637c47",
+        "split": "benchmark",
+    }
+
+    _SCHEMA = frozenset({"question", "answers", "solution"})
+
+    @staticmethod
+    def _content_sha256(row: Mapping[str, object]) -> str:
+        payload = json.dumps(dict(row), ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        return hashlib.sha256(payload).hexdigest()
+
+    @staticmethod
+    def _item_id(question: str) -> str:
+        digest = hashlib.sha256(question.encode("utf-8")).hexdigest()
+        return f"cybermetric:{digest}"
+
+    def download(self, data_dir=None, cache_dir=None, download_mode=None):
+        del data_dir, cache_dir, download_mode
+        source = self._verified_source()
+        if source.logical_path != "CyberMetric-500-v1.json":
+            raise ProbeTaskError("CyberMetric sealed source path is invalid")
+        encoded = parse_probe_json(source.payload, "CyberMetric source")
+        if not isinstance(encoded, Mapping) or set(encoded) != {"questions"}:
+            raise ProbeTaskError("CyberMetric sealed JSON schema is invalid")
+        rows = encoded["questions"]
+        if (
+            not isinstance(rows, list)
+            or any(not isinstance(row, Mapping) for row in rows)
+            or len(rows) != self.task_config.get("source_rows")
+        ):
+            raise ProbeTaskError("CyberMetric sealed source rows differ from authority")
+        self._set_verified_dataset([dict(row) for row in rows])
+
+    def _process_doc(self, row: Mapping[str, object], source_index: int):
+        if frozenset(row) != self._SCHEMA:
+            raise ProbeTaskError("CyberMetric row schema is invalid")
+        question = row.get("question")
+        if not isinstance(question, str) or not question.strip():
+            raise ProbeTaskError("CyberMetric question is invalid")
+        answers = row.get("answers")
+        solution = row.get("solution")
+        if not isinstance(answers, Mapping) or frozenset(answers) != frozenset("ABCD"):
+            raise ProbeTaskError("CyberMetric answers are invalid")
+        if any(not isinstance(answers[letter], str) or not answers[letter].strip() for letter in "ABCD"):
+            raise ProbeTaskError("CyberMetric answer text is invalid")
+        if not isinstance(solution, str) or solution not in ("A", "B", "C", "D"):
+            raise ProbeTaskError("CyberMetric solution is invalid")
+        return self._render_doc(
+            question=question,
+            choices=[answers[letter] for letter in "ABCD"],
+            gold="ABCD".index(solution),
+            stable_id=f"cybermetric:release_500_v1:{source_index}",
+            source_index=source_index,
+            metadata={
+                "source_native_id": None,
+                "source_position": source_index,
+                "source_content_sha256": self._content_sha256(row),
+                "source_commit": self.task_config.get("revision"),
+                "source_file": self._source_file_binding(required=False).get(
+                    "logical_path", "CyberMetric-500-v1.json"
+                ),
+                "source_file_sha256": self._source_file_binding(required=False).get("sha256"),
+                "item_id": self._item_id(question),
+            },
+        )
