+"""Strict multiple-choice mechanics for sealed probe populations."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import math
+import random
+import sys
+from collections.abc import Iterable, Mapping, Sequence
+from pathlib import Path
+from typing import Any, cast
+
+from oe_eval.tasks.base_task import MultipleChoiceTask
+from oe_eval.tasks.utils import make_mcq_prompt
+
+_SOURCE_FILES_NAME = "oe_eval.tasks.oe_eval_tasks.probe_source_files"
+_source_files = sys.modules.get(_SOURCE_FILES_NAME)
+if _source_files is None:
+    _source_files_spec = importlib.util.spec_from_file_location(
+        _SOURCE_FILES_NAME, Path(__file__).with_name("probe_source_files.py")
+    )
+    if _source_files_spec is None or _source_files_spec.loader is None:
+        raise RuntimeError("probe source-file reader cannot be loaded")
+    _source_files = importlib.util.module_from_spec(_source_files_spec)
+    sys.modules[_SOURCE_FILES_NAME] = _source_files
+    _source_files_spec.loader.exec_module(_source_files)
+VerifiedProbeSource = _source_files.VerifiedProbeSource
+ProbeSourceFileError = _source_files.ProbeSourceFileError
+load_verified_probe_source = _source_files.load_verified_probe_source
+parse_probe_json = _source_files.parse_strict_json
+
+
+class ProbeTaskError(ValueError):
+    """Raised when a source row is outside its exact probe population contract."""
+
+
+def _canonical_choice(value: str) -> str:
+    return value.strip()
+
+
+def _choice_labels(count: int) -> list[str]:
+    if not 2 <= count <= 26:
+        raise ProbeTaskError("invalid choice count")
+    return [chr(ord("A") + index) for index in range(count)]
+
+
+class SealedMultipleChoiceTask(MultipleChoiceTask):
+    """Zero-shot all-letter MC task with row-specific authorized exclusions only."""
+
+    TASK_CONFIG_DEFAULTS: dict[str, Any] = {
+        "native_id_field": "stable_id",
+        "primary_metric": "acc_raw",
+        "num_shots": 0,
+        "authorized_exclusions": [],
+        "population_policy": {
+            "exclude_mechanically_invalid_choices": True,
+            "reject_unapproved_invalid_choices": True,
+            "retain_cross_row_duplicates": True,
+        },
+    }
+
+    def _verified_source(self) -> VerifiedProbeSource:
+        try:
+            return load_verified_probe_source(self.task_config)
+        except ProbeSourceFileError as error:
+            raise ProbeTaskError(str(error)) from error
+
+    def _source_file_binding(self, *, required: bool = True) -> Mapping[str, object]:
+        scope = self.task_config.get("population_authority_scope")
+        if not isinstance(scope, Mapping):
+            if required:
+                raise ProbeTaskError("source authority scope is required")
+            return {}
+        source_input = scope.get("source_input_file")
+        if not isinstance(source_input, Mapping):
+            if required:
+                raise ProbeTaskError("source input binding is required")
+            return {}
+        return source_input
+
+    def _set_verified_dataset(self, rows: list[dict[str, object]]) -> None:
+        split = self.task_config.get("split")
+        if not isinstance(split, str) or not split:
+            raise ProbeTaskError("configured split must be nonempty text")
+        self.dataset = {split: rows}
+
+    def has_training_docs(self) -> bool:  # pyright: ignore[reportIncompatibleMethodOverride]
+        return self.task_config.get("split") == "train"
+
+    def has_validation_docs(self) -> bool:  # pyright: ignore[reportIncompatibleMethodOverride]
+        return self.task_config["split"] == "validation"
+
+    def has_test_docs(self) -> bool:  # pyright: ignore[reportIncompatibleMethodOverride]
+        return self.task_config.get("split") not in ("train", "validation")
+
+    def training_docs(self) -> Iterable[dict[str, object]]:
+        if not self.has_training_docs():
+            return []
+        return self._configured_split_docs()
+
+    def validation_docs(self) -> Iterable[dict[str, object]]:
+        if not self.has_validation_docs():
+            return []
+        return self._configured_split_docs()
+
+    def test_docs(self) -> Iterable[dict[str, object]]:
+        if not self.has_test_docs():
+            return []
+        return self._configured_split_docs()
+
+    def get_eval_docs(
+        self,
+        limit: int | float | None = None,
+        random_subsample_seed: int | None = None,
+    ) -> Sequence[dict[str, object]]:
+        documents = self._configured_split_docs()
+        if isinstance(limit, float):
+            limit = math.ceil(len(documents) * limit)
+        if limit is not None and len(documents) > limit:
+            if random_subsample_seed is None:
+                return documents[:limit]
+            return random.Random(random_subsample_seed).sample(documents, limit)
+        return documents
+
+    def _configured_split_docs(self) -> list[dict[str, object]]:
+        split = self.task_config.get("split")
+        if not isinstance(split, str) or not split:
+            raise ProbeTaskError("configured split must be nonempty text")
+        try:
+            rows = self.dataset[split]
+        except (KeyError, TypeError) as error:
+            raise ProbeTaskError(f"configured split {split!r} is unavailable") from error
+        return self._processed_docs(cast(Iterable[Mapping[str, object]], rows))
+
+    def _processed_docs(self, rows: Iterable[Mapping[str, object]]) -> list[dict[str, object]]:
+        self._validate_population_authority_scope()
+        self._consumed_authorized_exclusions: set[tuple[int, str, str]] = set()
+        processed: list[dict[str, object]] = []
+        source_count = 0
+        stable_ids: set[str] = set()
+        for source_index, row in enumerate(rows):
+            source_count += 1
+            document = self._process_doc(row, source_index)
+            if document is not None:
+                stable_id = document["stable_id"]
+                if not isinstance(stable_id, str) or stable_id in stable_ids:
+                    raise ProbeTaskError("processed rows must have unique stable IDs")
+                stable_ids.add(stable_id)
+                processed.append(document)
+        self._validate_population(processed, source_count)
+        return processed
+
+    def _process_doc(  # pyright: ignore[reportIncompatibleMethodOverride]
+        self, row: Mapping[str, object], source_index: int
+    ) -> dict[str, object] | None:
+        raise NotImplementedError
+
+    def doc_to_text(self, doc: Mapping[str, object]) -> str:  # pyright: ignore[reportIncompatibleMethodOverride]
+        query = doc.get("query")
+        if not isinstance(query, str):
+            raise ProbeTaskError("processed probe row has no query")
+        return query
+
+    def _render_doc(
+        self,
+        *,
+        question: object,
+        choices: Sequence[object],
+        gold: object,
+        stable_id: str,
+        source_index: int,
+        metadata: Mapping[str, object] | None = None,
+        source_native_id: object | None = None,
+    ) -> dict[str, object] | None:
+        if not isinstance(question, str) or not question.strip():
+            raise ProbeTaskError("question text must be nonempty")
+        if not isinstance(stable_id, str) or not stable_id:
+            raise ProbeTaskError("stable ID must be nonempty")
+        reasons = self._invalid_reasons(choices, gold)
+        if reasons:
+            self._consume_authorized_exclusion(
+                source_index=source_index,
+                stable_id=stable_id,
+                category="mechanically_invalid_exclusions",
+                reasons=reasons,
+                source_native_id=source_native_id,
+            )
+            return None
+        rendered_choices = [self._choice_text(value) for value in choices]
+        protected_fields = {
+            "stable_id",
+            "source_index",
+            "query",
+            "choices",
+            "gold",
+            "source_revision",
+            "source_config",
+            "source_split",
+            "source_binding",
+            "adapter_serializer_version",
+        }
+        if metadata is not None and protected_fields & set(metadata):
+            raise ProbeTaskError("metadata must not overwrite protected fields")
+        scope = self.task_config.get("population_authority_scope")
+        if not isinstance(scope, Mapping):
+            scope = {}
+        return {
+            "stable_id": stable_id,
+            "source_index": source_index,
+            "source_revision": self.task_config.get("revision"),
+            "source_config": self.task_config.get("dataset_name"),
+            "source_split": self.task_config.get("split"),
+            "source_binding": dict(scope.get("source_input_file", {})),
+            "adapter_serializer_version": "probe-v1",
+            **(dict(metadata) if metadata is not None else {}),
+            "query": make_mcq_prompt(question, rendered_choices),
+            "choices": _choice_labels(len(rendered_choices)),
+            "gold": gold,
+        }
+
+    def _invalid_reasons(self, choices: Sequence[object], gold: object) -> tuple[str, ...]:
+        reasons: list[str] = []
+        try:
+            _choice_labels(len(choices))
+        except ProbeTaskError:
+            reasons.append("choice_count")
+        if isinstance(gold, bool) or not isinstance(gold, int) or gold not in range(len(choices)):
+            reasons.append("gold_out_of_range")
+        normalized_choices: list[str] = []
+        contains_empty_choice = False
+        for value in choices:
+            if not isinstance(value, str):
+                contains_empty_choice = True
+                continue
+            normalized_choices.append(_canonical_choice(value))
+            if not value.strip():
+                contains_empty_choice = True
+        if contains_empty_choice:
+            reasons.append("empty_choices")
+        if normalized_choices and len(set(normalized_choices)) != len(normalized_choices):
+            reasons.append("duplicate_choices")
+        return tuple(reasons)
+
+    def _consume_authorized_exclusion(
+        self,
+        *,
+        source_index: int,
+        stable_id: str,
+        category: str,
+        reasons: Sequence[str],
+        source_native_id: object | None = None,
+    ) -> None:
+        records = self.task_config.get("authorized_exclusions")
+        if not isinstance(records, list):
+            raise ProbeTaskError("authorized exclusions must be a list")
+        matches = [
+            record
+            for record in records
+            if isinstance(record, Mapping)
+            and record.get("source_index") == source_index
+            and record.get("stable_id") == stable_id
+            and record.get("category") == category
+            and record.get("reasons") == list(reasons)
+            and (
+                "source_native_id" not in record
+                or (
+                    record["source_native_id"] == source_native_id
+                    and type(record["source_native_id"]) is type(source_native_id)
+                )
+            )
+        ]
+        if len(matches) != 1:
+            raise ProbeTaskError(f"unapproved exclusion at source index {source_index}")
+        key = (source_index, stable_id, category)
+        consumed = getattr(self, "_consumed_authorized_exclusions", set())
+        if key in consumed:
+            raise ProbeTaskError("authorized exclusion was consumed more than once")
+        consumed.add(key)
+        self._consumed_authorized_exclusions = consumed
+
+    def _validate_population_authority_scope(self) -> None:
+        scope = self.task_config.get("population_authority_scope")
+        if not isinstance(scope, Mapping):
+            raise ProbeTaskError("population authority scope is required")
+        expected = {
+            "source_id": self.task_config.get("dataset_path"),
+            "revision": self.task_config.get("revision"),
+            "config": self.task_config.get("dataset_name"),
+            "split": self.task_config.get("split"),
+            "stable_id_contract": self.task_config.get("stable_id_contract"),
+        }
+        if any(scope.get(name) != value for name, value in expected.items()):
+            raise ProbeTaskError("population authority scope does not match task config")
+        if not isinstance(scope.get("source_input_file"), Mapping):
+            raise ProbeTaskError("population authority source input file is required")
+        manifests = self.task_config.get("authorized_exclusion_manifests")
+        records = self.task_config.get("authorized_exclusions")
+        if not isinstance(manifests, Mapping) or not isinstance(records, list):
+            raise ProbeTaskError("population authority exclusion manifests are required")
+        for category in (
+            "mechanically_invalid_exclusions",
+            "format_ineligible_exclusions",
+            "policy_filter_exclusions",
+        ):
+            manifest = manifests.get(category)
+            if not isinstance(manifest, Mapping):
+                raise ProbeTaskError("population authority exclusion manifest is missing")
+            if manifest.get("source_scope") != {
+                "revision": scope["revision"],
+                "config": scope["config"],
+                "split": scope["split"],
+                "stable_id_contract": scope["stable_id_contract"],
+            }:
+                raise ProbeTaskError("population authority exclusion scope differs")
+            if manifest.get("count") != sum(
+                isinstance(record, Mapping) and record.get("category") == category for record in records
+            ):
+                raise ProbeTaskError("population authority exclusion count differs")
+            if not isinstance(manifest.get("records_sha256"), str) or not isinstance(
+                manifest.get("source_field_path"), list
+            ):
+                raise ProbeTaskError("population authority exclusion manifest is incomplete")
+
+    def _validate_population(self, documents: Sequence[Mapping[str, object]], source_count: int) -> None:
+        if source_count != self.task_config.get("source_rows"):
+            raise ProbeTaskError("source row count differs from population authority")
+        if len(documents) != self.task_config.get("selected_rows"):
+            raise ProbeTaskError("selected row count differs from population authority")
+        records = self.task_config.get("authorized_exclusions")
+        if not isinstance(records, list) or len(self._consumed_authorized_exclusions) != len(records):
+            raise ProbeTaskError("configured exclusions were not consumed exactly once")
+        pairs: list[tuple[str, str]] = []
+        triples: list[tuple[str, str, int]] = []
+        content: list[tuple[str, str, tuple[str, ...], int]] = []
+        for document in documents:
+            stable_id = document.get("stable_id")
+            gold = document.get("gold")
+            choices = document.get("choices")
+            if not isinstance(stable_id, str) or isinstance(gold, bool) or not isinstance(gold, int):
+                raise ProbeTaskError("processed row digest identity is invalid")
+            if not isinstance(choices, Sequence) or isinstance(choices, str) or gold not in range(len(choices)):
+                raise ProbeTaskError("processed row digest choices are invalid")
+            gold_label = _choice_labels(len(choices))[gold]
+            pairs.append((stable_id, gold_label))
+            triples.append((stable_id, gold_label, len(choices)))
+            query = document.get("query")
+            if not isinstance(query, str) or any(not isinstance(choice, str) for choice in choices):
+                raise ProbeTaskError("processed row content digest is invalid")
+            content.append((stable_id, query, tuple(choices), gold))
+        if self._digest_pairs(pairs) != self.task_config.get("selected_id_gold_sha256"):
+            raise ProbeTaskError("selected ID/gold digest differs from population authority")
+        if self._digest_triples(triples) != self.task_config.get("selected_id_gold_choice_count_sha256"):
+            raise ProbeTaskError("selected ID/gold/choice-count digest differs from population authority")
+        expected_content = self.task_config.get("selected_content_sha256")
+        if not isinstance(expected_content, str):
+            raise ProbeTaskError("selected rendered content digest is required")
+        if self._digest_content(content) != expected_content:
+            raise ProbeTaskError("selected rendered content digest differs from population authority")
+
+    @staticmethod
+    def _digest_pairs(pairs: Iterable[tuple[str, str]]) -> str:
+        digest = hashlib.sha256()
+        for pair in sorted(pairs, key=lambda item: item[0].encode("utf-8")):
+            digest.update(
+                json.dumps(pair, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")
+            )
+            digest.update(b"\n")
+        return digest.hexdigest()
+
+    @staticmethod
+    def _digest_triples(triples: Iterable[tuple[str, str, int]]) -> str:
+        digest = hashlib.sha256()
+        for triple in sorted(triples, key=lambda item: item[0].encode("utf-8")):
+            digest.update(
+                json.dumps(triple, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")
+            )
+            digest.update(b"\n")
+        return digest.hexdigest()
+
+    @staticmethod
+    def _digest_content(records: Iterable[tuple[str, str, tuple[str, ...], int]]) -> str:
+        digest = hashlib.sha256()
+        for stable_id, query, choices, gold in sorted(records, key=lambda item: item[0].encode("utf-8")):
+            digest.update(
+                json.dumps(
+                    {
+                        "stable_id": stable_id,
+                        "query": query,
+                        "choices": choices,
+                        "gold": gold,
+                    },
+                    ensure_ascii=False,
+                    sort_keys=True,
+                    separators=(",", ":"),
+                    allow_nan=False,
+                ).encode("utf-8")
+            )
+            digest.update(b"\n")
+        return digest.hexdigest()
+
+    @staticmethod
+    def _choice_text(value: object) -> str:
+        if not isinstance(value, str) or not value.strip():
+            raise ProbeTaskError("empty choices")
+        return value.strip()
+
+    def unconditioned_prompt(self) -> None:  # pyright: ignore[reportIncompatibleMethodOverride]
+        return None
