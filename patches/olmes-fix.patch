@@ -0,0 +1,114 @@
+"""Revision-pinned closed-book Bar Exam QA task for Probe."""
+
+from __future__ import annotations
+
+from io import BytesIO
+from collections.abc import Mapping
+
+from oe_eval.tasks.oe_eval_tasks.sealed_multiple_choice import SealedMultipleChoiceTask, ProbeTaskError
+
+
+_SCHEMA = frozenset(
+    {
+        "idx",
+        "dataset",
+        "example_id",
+        "prompt_id",
+        "source",
+        "subject",
+        "question_number",
+        "prompt",
+        "question",
+        "choice_a",
+        "choice_b",
+        "choice_c",
+        "choice_d",
+        "answer",
+        "gold_passage",
+        "gold_idx",
+    }
+)
+
+
+class BarExamQAMC(SealedMultipleChoiceTask):
+    TASK_CONFIG_DEFAULTS = {
+        **SealedMultipleChoiceTask.TASK_CONFIG_DEFAULTS,
+        "dataset_path": "reglab/barexam_qa",
+        "dataset_name": "qa",
+        "split": "test",
+    }
+
+    def download(self, data_dir=None, cache_dir=None, download_mode=None):
+        del data_dir, cache_dir, download_mode
+        source = self._verified_source()
+        if source.logical_path != "data/qa/test.csv":
+            raise ProbeTaskError("Bar Exam QA sealed source path is invalid")
+        try:
+            import pandas as pd
+
+            frame = pd.read_csv(BytesIO(source.payload), dtype=object)
+            rows = frame.where(frame.notna(), None).to_dict(orient="records")
+        except Exception as error:
+            raise ProbeTaskError("Bar Exam QA sealed CSV is malformed") from error
+        if any(not isinstance(row, Mapping) for row in rows) or len(rows) != self.task_config.get("source_rows"):
+            raise ProbeTaskError("Bar Exam QA sealed source rows differ from authority")
+        self._set_verified_dataset([dict(row) for row in rows])
+
+    def _process_doc(self, row: Mapping[str, object], source_index: int):
+        if frozenset(row) != _SCHEMA:
+            raise ProbeTaskError("Bar Exam QA row schema is invalid")
+        identifier = row.get("idx")
+        answer = row.get("answer")
+        example_id = row.get("example_id")
+        prompt_id = row.get("prompt_id")
+        question = row.get("question")
+        choices = [row.get(f"choice_{letter}") for letter in "abcd"]
+        if not isinstance(identifier, str) or not identifier.strip():
+            raise ProbeTaskError("Bar Exam QA idx is invalid")
+        if not isinstance(example_id, str) or not example_id.strip():
+            raise ProbeTaskError("Bar Exam QA example_id is invalid")
+        if not isinstance(prompt_id, str) or not prompt_id.strip():
+            raise ProbeTaskError("Bar Exam QA prompt_id is invalid")
+        if self._is_missing_text(question):
+            raise ProbeTaskError("Bar Exam QA question is invalid")
+        if any(self._is_missing_text(choice) for choice in choices):
+            raise ProbeTaskError("Bar Exam QA choices are invalid")
+        if not isinstance(answer, str) or answer not in ("A", "B", "C", "D"):
+            raise ProbeTaskError("Bar Exam QA answer is invalid")
+        return self._render_doc(
+            question=self._question(row),
+            choices=choices,
+            gold="ABCD".index(answer),
+            stable_id=f"bar_exam_qa:test:{identifier}",
+            source_index=source_index,
+            metadata={
+                "idx": identifier,
+                "example_id": example_id,
+                "prompt_id": prompt_id,
+                "subject": self._normalize_optional_text(row.get("subject")),
+            },
+        )
+
+    @staticmethod
+    def _is_missing_text(value: object) -> bool:
+        if value is None:
+            return True
+        if isinstance(value, str):
+            return not value.strip() or value.strip().casefold() == "nan"
+        return isinstance(value, float) and value != value
+
+    @classmethod
+    def _normalize_optional_text(cls, value: object) -> object:
+        return None if cls._is_missing_text(value) else value
+
+    @classmethod
+    def _question(cls, row: Mapping[str, object]) -> object:
+        question = row.get("question")
+        prompt = row.get("prompt")
+        if cls._is_missing_text(question):
+            return question
+        if not isinstance(question, str):
+            return question
+        if not isinstance(prompt, str) or cls._is_missing_text(prompt):
+            return question
+        return f"{prompt.strip()}\n\n{question}"
