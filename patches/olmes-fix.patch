@@ -0,0 +1,222 @@
+"""Receipt-bound ChemBench multiple-choice task for Probe."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from collections.abc import Mapping
+
+from oe_eval.tasks.oe_eval_tasks.sealed_multiple_choice import SealedMultipleChoiceTask, ProbeTaskError
+
+
+CHEMBENCH_CONFIGS = (
+    "analytical_chemistry",
+    "chemical_preference",
+    "general_chemistry",
+    "inorganic_chemistry",
+    "materials_science",
+    "organic_chemistry",
+    "physical_chemistry",
+    "technical_chemistry",
+    "toxicity_and_safety",
+)
+_SCHEMA = frozenset(
+    {
+        "canary",
+        "description",
+        "examples",
+        "in_humansubset_w_tool",
+        "in_humansubset_wo_tool",
+        "keywords",
+        "metrics",
+        "name",
+        "preferred_score",
+        "uuid",
+        "subfield",
+    }
+)
+_EXAMPLE_SCHEMA = frozenset({"input", "target", "target_scores"})
+
+
+class ChemBenchMC(SealedMultipleChoiceTask):
+    TASK_CONFIG_DEFAULTS = {
+        **SealedMultipleChoiceTask.TASK_CONFIG_DEFAULTS,
+        "dataset_path": "jablonkagroup/ChemBench",
+        "dataset_name": "analytical_chemistry",
+        "revision": "6e1d25748952393f44e35b8e85bbe567246a6430",
+        "split": "train",
+    }
+
+    @staticmethod
+    def _parse_scores(value: object) -> dict[str, object]:
+        if not isinstance(value, str):
+            raise ProbeTaskError("ChemBench target_scores must be JSON text")
+
+        def reject_constant(token: str) -> object:
+            raise ValueError(f"non-standard JSON constant {token}")
+
+        def reject_duplicate(pairs: list[tuple[str, object]]) -> dict[str, object]:
+            result: dict[str, object] = {}
+            for key, item in pairs:
+                if key in result:
+                    raise ProbeTaskError("ChemBench target_scores has duplicate choices")
+                result[key] = item
+            return result
+
+        try:
+            parsed = json.loads(
+                value,
+                object_pairs_hook=reject_duplicate,
+                parse_constant=reject_constant,
+            )
+        except ProbeTaskError:
+            raise
+        except (TypeError, ValueError, json.JSONDecodeError) as error:
+            raise ProbeTaskError("ChemBench target_scores is malformed") from error
+        if not isinstance(parsed, dict):
+            raise ProbeTaskError("ChemBench target_scores must be an object")
+        return parsed
+
+    @staticmethod
+    def _content_sha256(row: Mapping[str, object]) -> str:
+        payload = json.dumps(dict(row), ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        return hashlib.sha256(payload).hexdigest()
+
+    def download(self, data_dir=None, cache_dir=None, download_mode=None):
+        del data_dir, cache_dir, download_mode
+        source = self._verified_source()
+        binding = self._source_file_binding()
+        logical_path = binding.get("logical_path")
+        if source.logical_path != logical_path:
+            raise ProbeTaskError("ChemBench sealed source path differs from authority")
+        try:
+            import pyarrow.parquet as parquet
+
+            rows = parquet.read_table(source.source_path).to_pylist()
+        except Exception as error:
+            raise ProbeTaskError("ChemBench sealed Parquet is malformed") from error
+        if any(not isinstance(row, Mapping) for row in rows) or len(rows) != self.task_config.get("source_rows"):
+            raise ProbeTaskError("ChemBench sealed source rows differ from authority")
+        self._set_verified_dataset([dict(row) for row in rows])
+
+    def _process_doc(self, row: Mapping[str, object], source_index: int):
+        if frozenset(row) != _SCHEMA:
+            raise ProbeTaskError("ChemBench row schema is invalid")
+        config = self.task_config.get("dataset_name")
+        if config not in CHEMBENCH_CONFIGS:
+            raise ProbeTaskError("ChemBench config is invalid")
+        uuid = row.get("uuid")
+        if not isinstance(uuid, str) or not uuid.strip():
+            raise ProbeTaskError("ChemBench uuid is invalid")
+        for field in ("canary", "description", "name", "subfield"):
+            if not isinstance(row[field], str):
+                raise ProbeTaskError(f"ChemBench {field} is invalid")
+        for field in ("in_humansubset_w_tool", "in_humansubset_wo_tool"):
+            if not isinstance(row[field], bool):
+                raise ProbeTaskError(f"ChemBench {field} is invalid")
+        for field in ("keywords", "metrics"):
+            values = row[field]
+            if not isinstance(values, list) or any(not isinstance(item, str) for item in values):
+                raise ProbeTaskError(f"ChemBench {field} is invalid")
+        preferred_score = row.get("preferred_score")
+        if not isinstance(preferred_score, str) or not preferred_score.strip():
+            raise ProbeTaskError("ChemBench preferred_score is invalid")
+        examples = row.get("examples")
+        if not isinstance(examples, list) or len(examples) != 1 or not isinstance(examples[0], Mapping):
+            raise ProbeTaskError("ChemBench examples are invalid")
+        example = examples[0]
+        if frozenset(example) != _EXAMPLE_SCHEMA:
+            raise ProbeTaskError("ChemBench example schema is invalid")
+        for field in ("target", "target_scores"):
+            if example[field] is not None and not isinstance(example[field], str):
+                raise ProbeTaskError(f"ChemBench {field} is invalid")
+        question = example.get("input")
+        if not isinstance(question, str) or not question.strip():
+            raise ProbeTaskError("ChemBench examples.input is invalid")
+        stable_id = f"chembench:{config}:{uuid}:0"
+        metadata = {
+            "uuid": uuid,
+            "example_index": 0,
+            "chembench_config": config,
+            "w_tool": row["in_humansubset_w_tool"],
+        }
+        if preferred_score != "multiple_choice_grade":
+            self._consume_authorized_exclusion(
+                source_index=source_index,
+                stable_id=stable_id,
+                category="format_ineligible_exclusions",
+                reasons=("preferred_score_not_multiple_choice_grade",),
+                source_native_id=uuid,
+            )
+            return None
+        metrics = row["metrics"]
+        if not isinstance(metrics, list):
+            raise ProbeTaskError("ChemBench metrics are invalid")
+        if "multiple_choice_grade" not in metrics:
+            raise ProbeTaskError("ChemBench multiple-choice metric is absent")
+        if example["target"] is not None:
+            raise ProbeTaskError("ChemBench MC target must be null")
+        scores = self._parse_scores(example["target_scores"])
+        choices = list(scores)
+        reasons: list[str] = []
+        if not 2 <= len(choices) <= 26:
+            reasons.append("choice_count")
+        normalized = [" ".join(choice.split()).casefold() for choice in choices]
+        if any(not choice.strip() for choice in choices):
+            reasons.append("empty_choices")
+        if normalized and len(set(normalized)) != len(normalized):
+            reasons.append("duplicate_choices")
+        one_scores: list[int] = []
+        gold_indices: list[int] = []
+        has_non_binary_score = False
+        for index, value in enumerate(scores.values()):
+            try:
+                numeric = (
+                    float(value) if not isinstance(value, bool) and isinstance(value, (int, float)) else math.nan
+                )
+            except (OverflowError, TypeError, ValueError):
+                numeric = math.nan
+            if not math.isfinite(numeric) or numeric not in (0.0, 1.0):
+                has_non_binary_score = True
+            else:
+                one_scores.append(int(numeric == 1.0))
+                if numeric == 1.0:
+                    gold_indices.append(index)
+        if has_non_binary_score:
+            reasons.append("non_binary_scores")
+        if sum(one_scores) != 1:
+            reasons.append("non_unique_gold")
+        if reasons:
+            self._consume_authorized_exclusion(
+                source_index=source_index,
+                stable_id=stable_id,
+                category="mechanically_invalid_exclusions",
+                reasons=tuple(reasons),
+                source_native_id=uuid,
+            )
+            return None
+        policy = self.task_config.get("population_policy")
+        exclude_w_tool = isinstance(policy, Mapping) and (
+            policy.get("exclude_w_tool") is True
+            or policy.get("chembench_sensitivity") == "strict_without_w_tool_flag"
+        )
+        if exclude_w_tool and row["in_humansubset_w_tool"]:
+            self._consume_authorized_exclusion(
+                source_index=source_index,
+                stable_id=stable_id,
+                category="policy_filter_exclusions",
+                reasons=("in_humansubset_w_tool_true",),
+                source_native_id=uuid,
+            )
+            return None
+        gold = gold_indices[0]
+        return self._render_doc(
+            question=question,
+            choices=choices,
+            gold=gold,
+            stable_id=stable_id,
+            source_index=source_index,
+            source_native_id=uuid,
+            metadata=metadata,
+        )
