+"""Revision-pinned InfoTabS task with split-qualified stable IDs."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+from oe_eval.tasks.oe_eval_tasks.sealed_multiple_choice import SealedMultipleChoiceTask, ProbeTaskError
+
+
+class InfoTabSMC(SealedMultipleChoiceTask):
+    TASK_CONFIG_DEFAULTS = {
+        **SealedMultipleChoiceTask.TASK_CONFIG_DEFAULTS,
+        "dataset_path": "table-benchmark/infotabs",
+        "dataset_name": "default",
+        "revision": "5e26f025fbbf2055f6905cf553ad9c81048891ea",
+        "split": "test1",
+    }
+
+    _SCHEMA = frozenset(
+        {
+            "original_dataset_id",
+            "dataset_name",
+            "table",
+            "table_title",
+            "text",
+            "question",
+            "answer",
+        }
+    )
+
+    _CANONICAL_SOURCE_REVISION = "34e7dc0900a0d861ad62be3d7371d8eb0aace4fe"
+
+    def download(self, data_dir=None, cache_dir=None, download_mode=None):
+        del data_dir, cache_dir, download_mode
+        source = self._verified_source()
+        split = self.task_config.get("split")
+        if (
+            split not in {"test1", "test2", "test3"}
+            or source.logical_path != f"data/{split}-00000-of-00001.parquet"
+        ):
+            raise ProbeTaskError("InfoTabS sealed source path is invalid")
+        try:
+            import pyarrow.parquet as parquet
+
+            rows = parquet.read_table(source.source_path).to_pylist()
+        except Exception as error:
+            raise ProbeTaskError("InfoTabS sealed Parquet is malformed") from error
+        if any(not isinstance(row, Mapping) for row in rows) or len(rows) != self.task_config.get("source_rows"):
+            raise ProbeTaskError("InfoTabS sealed source rows differ from authority")
+        self._set_verified_dataset([dict(row) for row in rows])
+
+    def _process_doc(self, row: Mapping[str, object], source_index: int):
+        split = self.task_config.get("split", "test1")
+        if frozenset(row) != self._SCHEMA:
+            raise ProbeTaskError("InfoTabS row schema is invalid")
+        identifier = row.get("original_dataset_id")
+        answer = row.get("answer")
+        if split not in ("test1", "test2", "test3"):
+            raise ProbeTaskError("InfoTabS split is invalid")
+        if not isinstance(identifier, str) or not identifier.strip():
+            raise ProbeTaskError("InfoTabS original_dataset_id is invalid")
+        if row["dataset_name"] != "infotabs":
+            raise ProbeTaskError("InfoTabS dataset_name is invalid")
+        if row["text"] is not None:
+            raise ProbeTaskError("InfoTabS text must be null")
+        labels = ("Entailment", "Contradiction", "Neutral")
+        if answer not in labels:
+            raise ProbeTaskError("InfoTabS answer is invalid")
+        return self._render_doc(
+            question=self._question(row),
+            choices=labels,
+            gold=labels.index(answer),
+            stable_id=f"infotabs:{split}:{identifier}",
+            source_index=source_index,
+            metadata={
+                "original_dataset_id": identifier,
+                "canonical_source_revision": self._CANONICAL_SOURCE_REVISION,
+                "alpha_population": {"test1": "alpha1", "test2": "alpha2", "test3": "alpha3"}[split],
+            },
+        )
+
+    @staticmethod
+    def _question(row: Mapping[str, object]) -> str:
+        table = row.get("table")
+        title = row.get("table_title")
+        question = row.get("question")
+        if not isinstance(table, str) or not table.strip():
+            raise ProbeTaskError("InfoTabS table is invalid")
+        if not isinstance(title, str):
+            raise ProbeTaskError("InfoTabS table_title is invalid")
+        if not isinstance(question, str) or not question.strip():
+            raise ProbeTaskError("InfoTabS table row is malformed")
+        return f"Table title: {title}\nTable: {table}\n\nHypothesis: {question}"
