+"""Revision-pinned CTI-MCQ task for Probe."""
+
+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+from collections.abc import Mapping
+from io import StringIO
+
+from oe_eval.tasks.oe_eval_tasks.sealed_multiple_choice import SealedMultipleChoiceTask, ProbeTaskError
+
+
+class CTIMCQ(SealedMultipleChoiceTask):
+    TASK_CONFIG_DEFAULTS = {
+        **SealedMultipleChoiceTask.TASK_CONFIG_DEFAULTS,
+        "dataset_path": "AI4Sec/cti-bench",
+        "dataset_name": "cti-mcq",
+        "revision": "9237e1636ee3e168fbe5ebdcc1c571de0525e568",
+        "split": "test",
+    }
+
+    _SCHEMA = frozenset(
+        {
+            "URL",
+            "Question",
+            "Option A",
+            "Option B",
+            "Option C",
+            "Option D",
+            "Prompt",
+            "GT",
+        }
+    )
+
+    def download(self, data_dir=None, cache_dir=None, download_mode=None):
+        del data_dir, cache_dir, download_mode
+        source = self._verified_source()
+        if source.logical_path != "cti-mcq.tsv":
+            raise ProbeTaskError("CTI-MCQ sealed source path is invalid")
+        try:
+            rows = list(csv.DictReader(StringIO(source.payload.decode("utf-8")), delimiter="\t"))
+        except UnicodeDecodeError as error:
+            raise ProbeTaskError("CTI-MCQ sealed TSV is not UTF-8") from error
+        if any(None in row or None in row.values() for row in rows) or len(rows) != self.task_config.get(
+            "source_rows"
+        ):
+            raise ProbeTaskError("CTI-MCQ sealed source rows differ from authority")
+        self._set_verified_dataset([dict(row) for row in rows])
+
+    @staticmethod
+    def _content_sha256(row: Mapping[str, object]) -> str:
+        payload = json.dumps(dict(row), ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        return hashlib.sha256(payload).hexdigest()
+
+    def _process_doc(self, row: Mapping[str, object], source_index: int):
+        if frozenset(row) != self._SCHEMA:
+            raise ProbeTaskError("CTI-MCQ row schema is invalid")
+        question = row.get("Question")
+        url = row.get("URL")
+        prompt = row.get("Prompt")
+        if not isinstance(question, str) or not question.strip():
+            raise ProbeTaskError("CTI-MCQ Question is invalid")
+        if not isinstance(url, str) or not url.strip():
+            raise ProbeTaskError("CTI-MCQ URL is invalid")
+        if not isinstance(prompt, str) or not prompt.strip():
+            raise ProbeTaskError("CTI-MCQ Prompt is invalid")
+        for letter in "ABCD":
+            value = row[f"Option {letter}"]
+            if value is not None and not isinstance(value, str):
+                raise ProbeTaskError("CTI-MCQ choices are invalid")
+        answer = row.get("GT")
+        if not isinstance(answer, str) or answer not in (*"ABCD", "b"):
+            raise ProbeTaskError("CTI-MCQ GT gold label is invalid")
+        return self._render_doc(
+            question=question,
+            choices=[row.get(f"Option {letter}") for letter in "ABCD"],
+            gold="ABCD".index(answer.upper()),
+            stable_id=f"cti_mcq:test:{source_index}",
+            source_index=source_index,
+            metadata={
+                "source_native_id": None,
+                "source_position": source_index,
+                "source_content_sha256": self._content_sha256(row),
+            },
+        )
