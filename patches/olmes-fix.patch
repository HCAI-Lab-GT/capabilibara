+def _read_regular_file(path, label):
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f"Probe PIQA {label} is not a regular file")
+    try:
+        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+    except OSError as error:
+        raise ValueError(f"Probe PIQA {label} cannot be opened without following") from error
+    with os.fdopen(descriptor, "rb") as handle:
+        metadata = os.fstat(handle.fileno())
+        if not stat.S_ISREG(metadata.st_mode):
+            raise ValueError(f"Probe PIQA {label} is not a regular file")
+        digest = hashlib.sha256()
+        content = bytearray()
+        for chunk in iter(lambda: handle.read(64 * 1024), b""):
+            content.extend(chunk)
+            digest.update(chunk)
+    return bytes(content), len(content), digest.hexdigest()
+
+
+def _read_piqa_dataset_receipt():
+    raw = os.environ.get("PROBE_PIQA_DATASET_RECEIPT")
+    if raw is None:
+        return None
+    try:
+        reference = json.loads(raw)
+    except json.JSONDecodeError as error:
+        raise ValueError("Probe PIQA authority reference is invalid") from error
+    if set(reference) != {"path", "sha256", "byte_count"}:
+        raise ValueError("Probe PIQA authority reference fields differ")
+    path = reference["path"]
+    digest = reference["sha256"]
+    byte_count = reference["byte_count"]
+    if (
+        not isinstance(path, str)
+        or not Path(path).is_absolute()
+        or not isinstance(digest, str)
+        or len(digest) != 64
+        or any(character not in "0123456789abcdef" for character in digest)
+        or isinstance(byte_count, bool)
+        or not isinstance(byte_count, int)
+        or byte_count < 1
+    ):
+        raise ValueError("Probe PIQA authority reference is malformed")
+    return Path(path), byte_count, digest
+
+
+def _is_sealed_piqa_dataset_receipt(authority, config):
+    if not isinstance(authority, dict):
+        return False
+    external_source = authority.get("external_source")
+    return (
+        authority.get("schema_version") == 1
+        and authority.get("kind") == "probe-native-dataset-receipt"
+        and authority.get("task") == "piqa"
