@@ -0,0 +1,157 @@
+"""Receipt-bound ClimaQA Gold MCQ task for Probe."""
+
+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+import re
+from collections.abc import Mapping
+
+from oe_eval.tasks.oe_eval_tasks.sealed_multiple_choice import SealedMultipleChoiceTask, ProbeTaskError
+
+
+_SCHEMA = frozenset({"Unnamed: 0", "Question", "Options", "Answer", "Complexity", "Validation"})
+_COMPLEXITIES = frozenset({"BASE", "REASONING", "HYPOTHETICAL"})
+_OPTION = re.compile(r"^([a-d])\)\s+(.+)$")
+
+
+class ClimaQAMC(SealedMultipleChoiceTask):
+    TASK_CONFIG_DEFAULTS = {
+        **SealedMultipleChoiceTask.TASK_CONFIG_DEFAULTS,
+        "dataset_path": "Rose-STL-Lab/ClimaQA",
+        "dataset_name": "Gold",
+        "revision": "3f084a0202c6260e588fb5b681d2e4ec859a3845",
+        "split": "mcq",
+    }
+
+    @staticmethod
+    def _content_sha256(row: Mapping[str, object]) -> str:
+        payload = json.dumps(dict(row), ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        return hashlib.sha256(payload).hexdigest()
+
+    @staticmethod
+    def _options(value: object) -> tuple[list[str], tuple[str, ...]]:
+        if not isinstance(value, str) or not value.strip():
+            raise ProbeTaskError("ClimaQA Options are invalid")
+        lines = [line.strip() for line in value.splitlines() if line.strip() and set(line.strip()) != {"-"}]
+        matches = [_OPTION.fullmatch(line) for line in lines]
+        if len(matches) != 4 or any(match is None for match in matches):
+            raise ProbeTaskError("ClimaQA options format is invalid")
+        complete = [match for match in matches if match is not None]
+        if [match.group(1) for match in complete] != list("abcd"):
+            raise ProbeTaskError("ClimaQA options format is invalid")
+        choices = [match.group(2).strip() for match in complete]
+        if any(not choice for choice in choices):
+            raise ProbeTaskError("ClimaQA options contain an empty choice")
+        normalized = [" ".join(choice.split()).casefold() for choice in choices]
+        reasons: list[str] = []
+        if len(set(normalized)) != len(normalized):
+            reasons.append("duplicate_choices")
+        return choices, tuple(reasons)
+
+    @staticmethod
+    def _parse_csv(payload: bytes) -> list[dict[str, object]]:
+        try:
+            text = payload.decode("utf-8")
+        except UnicodeDecodeError as error:
+            raise ProbeTaskError("ClimaQA source CSV is not UTF-8") from error
+        reader = csv.DictReader(text.splitlines(keepends=True))
+        if reader.fieldnames is None:
+            raise ProbeTaskError("ClimaQA source CSV has no header")
+        fieldnames = list(reader.fieldnames)
+        if fieldnames and fieldnames[0] == "":
+            fieldnames[0] = "Unnamed: 0"
+        if frozenset(fieldnames) != _SCHEMA or len(fieldnames) != len(_SCHEMA):
+            raise ProbeTaskError("ClimaQA source CSV schema is invalid")
+        rows: list[dict[str, object]] = []
+        for raw in reader:
+            row: dict[str, object] = {}
+            for key, value in raw.items():
+                if key is None or value is None:
+                    raise ProbeTaskError("ClimaQA source CSV row is malformed")
+                row["Unnamed: 0" if key == "" else key] = value
+            try:
+                native_id = int(str(row["Unnamed: 0"]).strip())
+            except (TypeError, ValueError) as error:
+                raise ProbeTaskError("ClimaQA native ID is invalid") from error
+            validation_value = row["Validation"]
+            if validation_value == "True":
+                validation = True
+            elif validation_value == "False":
+                validation = False
+            else:
+                raise ProbeTaskError("ClimaQA Validation must be Boolean")
+            row["Unnamed: 0"] = native_id
+            row["Validation"] = validation
+            rows.append(row)
+        return rows
+
+    def download(self, data_dir=None, cache_dir=None, download_mode=None):
+        del data_dir, cache_dir, download_mode
+        source = self._verified_source()
+        binding = self._source_file_binding()
+        if source.logical_path != binding.get("logical_path"):
+            raise ProbeTaskError("ClimaQA sealed source path differs from authority")
+        rows = self._parse_csv(source.payload)
+        if len(rows) != self.task_config.get("source_rows"):
+            raise ProbeTaskError("ClimaQA sealed source row count differs from authority")
+        self._set_verified_dataset(rows)
+
+    def _process_doc(self, row: Mapping[str, object], source_index: int):
+        if frozenset(row) != _SCHEMA:
+            raise ProbeTaskError("ClimaQA row schema is invalid")
+        native_id = row.get("Unnamed: 0")
+        if isinstance(native_id, bool) or not isinstance(native_id, int) or native_id < 0:
+            raise ProbeTaskError("ClimaQA native ID is invalid")
+        question = row.get("Question")
+        if not isinstance(question, str) or not question.strip():
+            raise ProbeTaskError("ClimaQA Question is invalid")
+        answer = row.get("Answer")
+        if not isinstance(answer, str) or answer not in ("a", "b", "c", "d"):
+            raise ProbeTaskError("ClimaQA Answer is invalid")
+        complexity = row.get("Complexity")
+        if not isinstance(complexity, str) or complexity not in _COMPLEXITIES:
+            raise ProbeTaskError("ClimaQA Complexity is invalid")
+        validation = row.get("Validation")
+        if not isinstance(validation, bool):
+            raise ProbeTaskError("ClimaQA Validation must be Boolean")
+        choices, reasons = self._options(row.get("Options"))
+        stable_id = f"climaqa:Gold:mcq:{native_id}"
+        if reasons:
+            self._consume_authorized_exclusion(
+                source_index=source_index,
+                stable_id=stable_id,
+                category="mechanically_invalid_exclusions",
+                reasons=reasons,
+                source_native_id=native_id,
+            )
+            return None
+        policy = self.task_config.get("population_policy")
+        include_validation_false = isinstance(policy, Mapping) and (
+            policy.get("include_validation_false") is True
+            or policy.get("climaqa_sensitivity") == "strict_unique_choices"
+        )
+        if not validation and not include_validation_false:
+            self._consume_authorized_exclusion(
+                source_index=source_index,
+                stable_id=stable_id,
+                category="policy_filter_exclusions",
+                reasons=("validation_false",),
+                source_native_id=native_id,
+            )
+            return None
+        return self._render_doc(
+            question=question,
+            choices=choices,
+            gold="abcd".index(answer),
+            stable_id=stable_id,
+            source_index=source_index,
+            source_native_id=native_id,
+            metadata={
+                "raw_index": native_id,
+                "source_content_sha256": self._content_sha256(row),
+                "complexity": complexity,
+                "validation": validation,
+            },
+        )
