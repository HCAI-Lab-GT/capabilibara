+def _exclusion_roster(value: object) -> dict[int, str]:
+    if isinstance(value, (str, bytes)) or not isinstance(value, Sequence):
+        raise ValueError("excluded source rows must be a sequence")
+    exclusions_by_index: dict[int, str] = {}
+    excluded_ids: set[str] = set()
+    for exclusion in value:
+        if not isinstance(exclusion, Mapping):
+            raise ValueError("excluded source row must bind index and id")
+        index = exclusion.get("index")
+        source_id = exclusion.get("id")
+        if type(index) is not int or not isinstance(source_id, str) or not source_id:
+            raise ValueError("excluded source row must bind index and id")
+        if index in exclusions_by_index or source_id in excluded_ids:
+            raise ValueError("duplicate excluded source row")
+        exclusions_by_index[index] = source_id
+        excluded_ids.add(source_id)
+    return exclusions_by_index
+
+
+def _validate_choice_texts(values: object, source_index: int) -> None:
+    if isinstance(values, (str, bytes)) or not isinstance(values, Sequence):
+        raise ValueError(f"choice text must be a sequence at source index {source_index}")
+    if len(values) < 2:
+        raise ValueError(f"at least two choices are required at source index {source_index}")
+    normalized = []
+    for value in values:
+        if not isinstance(value, str) or not value.strip():
+            raise ValueError(f"choice text must be nonempty text at source index {source_index}")
+        normalized.append(value.strip())
+    if len(set(normalized)) != len(normalized):
+        raise ValueError(f"duplicate choice text at source index {source_index}")
