+
+def apply_content_authority(configs: dict[str, dict[str, Any]]) -> None:
+    """Attach cache-source and rendered-content receipts without source text."""
+
+    for alias, digest in CONTENT_SHA256.items():
+        config = configs[alias]
+        source = _primary_source(config["population_authority_scope"])
+        config["selected_content_sha256"] = digest
+        config["source_cache_authority"] = {
+            "authority_manifest_sha256": AUTHORITY_MANIFEST_SHA256,
+            "authority_population_order": list(POPULATION_ORDER),
+            "source": {
+                "probe_id": config["probe_id"],
+                "logical_path": source["logical_path"],
+                "expected_sha256": _source_value(source, "member_sha256", "sha256"),
+                "expected_size_bytes": _source_value(source, "member_size_bytes", "size_bytes"),
+            },
+        }
+
+
+def _primary_source(scope: Mapping[str, object]) -> Mapping[str, object]:
+    source = scope["source_input_file"]
+    if not isinstance(source, Mapping):
+        raise ValueError("Probe source authority is malformed")
+    if "qa_files" in source:
+        source = source["qa_files"]
+        if not isinstance(source, Mapping):
+            raise ValueError("Probe Bar Exam source authority is malformed")
+        source = source["test"]
+    elif "primary" in source:
+        source = source["primary"]
+    if not isinstance(source, Mapping):
+        raise ValueError("Probe primary source authority is malformed")
+    return source
+
+
+def _source_value(source: Mapping[str, object], member: str, direct: str) -> object:
+    return source[member] if member in source else source[direct]
