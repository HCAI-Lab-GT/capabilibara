+        for pattern, score in backup_patterns:
+            match = re.search(pattern, continuation)
+            if match:
+                answer_string = match.group(1).upper()
+                answer_format_correct = score
+                break
+        if answer_string is None:
+            answer_string = ""
+        answer = re.sub("\\(|\\)", "", answer_string)
+        return {"answer": answer, "answer_format_correct": answer_format_correct}
diff --git a/oe_eval/tasks/oe_eval_tasks/tabfact.py b/oe_eval/tasks/oe_eval_tasks/tabfact.py
new file mode 100644
index 0000000000000000000000000000000000000000..598bbef90abf6e9b0dda73b4ee054ff69b2a847b
--- /dev/null
+++ b/oe_eval/tasks/oe_eval_tasks/tabfact.py
@@ -0,0 +1,85 @@
+"""Revision-pinned TabFact task rendered as a two-letter MC question."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+from oe_eval.tasks.oe_eval_tasks.sealed_multiple_choice import SealedMultipleChoiceTask, ProbeTaskError
+
+
+_CANONICAL_SOURCE_REVISION = "2ab782ba42b5808076ac91fec846473aa5315a79"
+
+
+class TabFactMC(SealedMultipleChoiceTask):
+    TASK_CONFIG_DEFAULTS = {
+        **SealedMultipleChoiceTask.TASK_CONFIG_DEFAULTS,
+        "dataset_path": "table-benchmark/tabfact",
+        "dataset_name": "default",
+        "revision": "3c4093ff6af427c8fc6bfac50353d6aba5539a3f",
+        "split": "test",
+    }
+
+    _SCHEMA = frozenset(
+        {
+            "original_dataset_id",
+            "dataset_name",
+            "table",
+            "table_title",
+            "text",
+            "question",
+            "answer",
+        }
+    )
+
+    def download(self, data_dir=None, cache_dir=None, download_mode=None):
+        del data_dir, cache_dir, download_mode
+        source = self._verified_source()
+        if source.logical_path != "data/test-00000-of-00001.parquet":
+            raise ProbeTaskError("TabFact sealed source path is invalid")
+        try:
+            import pyarrow.parquet as parquet
+
+            rows = parquet.read_table(source.source_path).to_pylist()
+        except Exception as error:
+            raise ProbeTaskError("TabFact sealed Parquet is malformed") from error
+        if any(not isinstance(row, Mapping) for row in rows) or len(rows) != self.task_config.get("source_rows"):
+            raise ProbeTaskError("TabFact sealed source rows differ from authority")
+        self._set_verified_dataset([dict(row) for row in rows])
+
+    def _process_doc(self, row: Mapping[str, object], source_index: int):
+        if frozenset(row) != self._SCHEMA:
+            raise ProbeTaskError("TabFact row schema is invalid")
+        identifier = row["original_dataset_id"]
+        if not isinstance(identifier, str) or not identifier.strip():
+            raise ProbeTaskError("TabFact original_dataset_id is invalid")
+        if row["dataset_name"] != "tabfact":
+            raise ProbeTaskError("TabFact dataset_name is invalid")
+        if row["text"] is not None:
+            raise ProbeTaskError("TabFact text must be null")
+        answer = row.get("answer")
+        if answer not in ("Entailed", "Refuted"):
+            raise ProbeTaskError("TabFact answer is invalid")
+        return self._render_doc(
+            question=self._question(row),
+            choices=["Entailed", "Refuted"],
+            gold=("Entailed", "Refuted").index(answer),
+            stable_id=f"tabfact:test:{source_index:05d}",
+            source_index=source_index,
+            metadata={
+                "original_dataset_id": identifier,
+                "canonical_source_revision": _CANONICAL_SOURCE_REVISION,
+            },
+        )
+
+    @staticmethod
+    def _question(row: Mapping[str, object]) -> str:
+        table = row.get("table")
+        title = row.get("table_title")
+        question = row.get("question")
+        if not isinstance(table, str) or not table.strip():
+            raise ProbeTaskError("TabFact table is invalid")
+        if not isinstance(title, str):
+            raise ProbeTaskError("TabFact table_title is invalid")
+        if not isinstance(question, str) or not question.strip():
+            raise ProbeTaskError("TabFact table row is malformed")
+        return f"Table title: {title}\nTable: {table}\n\nStatement: {question}"
