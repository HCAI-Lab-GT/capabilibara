+"""Shared fail-closed source filtering for Probe multiple-choice tasks."""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Iterable, Mapping, Sequence
+from typing import Any
+
+
+def validation_docs_with_exclusions(
+    rows: Iterable[Mapping[str, Any]],
+    excluded_source_rows: object,
+    *,
+    choice_texts: Callable[[Mapping[str, Any]], object],
+    process_doc: Callable[[Mapping[str, Any], int], dict[str, Any]],
+) -> list[dict[str, Any]]:
+    """Apply one exact index/ID exclusion roster before rendering choices."""
+
+    exclusions_by_index = _exclusion_roster(excluded_source_rows)
+    processed_docs = []
+    found_indices = set()
+    for index, doc in enumerate(rows):
+        expected_id = exclusions_by_index.get(index)
+        if expected_id is not None:
+            if doc.get("id") != expected_id:
+                raise ValueError("excluded source ID mismatch")
+            found_indices.add(index)
+            continue
+        _validate_choice_texts(choice_texts(doc), index)
+        processed_docs.append(process_doc(doc, index))
