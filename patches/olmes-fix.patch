+"""Revision-pinned MathQA multiple-choice task for Probe."""
+
+from __future__ import annotations
+
+import ast
+from collections.abc import Mapping
+
+from oe_eval.tasks.oe_eval_tasks.sealed_multiple_choice import (
+    SealedMultipleChoiceTask,
+    ProbeTaskError,
+    parse_probe_json,
+)
+
+
+_OPTION_MARKERS = tuple(f"{letter} ) " for letter in "abcde")
+_SCHEMA = frozenset(
+    {
+        "Problem",
+        "Rationale",
+        "options",
+        "correct",
+        "annotated_formula",
+        "linear_formula",
+        "category",
+    }
+)
+
+
+class MathQAMC(SealedMultipleChoiceTask):
+    TASK_CONFIG_DEFAULTS = {
+        **SealedMultipleChoiceTask.TASK_CONFIG_DEFAULTS,
+        "dataset_path": "allenai/math_qa",
+        "dataset_name": "default",
+        "split": "test",
+    }
+
+    def download(self, data_dir=None, cache_dir=None, download_mode=None):
+        del data_dir, cache_dir, download_mode
+        source = self._verified_source()
+        if source.logical_path != "MathQA.zip::test.json":
+            raise ProbeTaskError("MathQA sealed source path is invalid")
+        rows = parse_probe_json(source.payload, "MathQA source")
+        if not isinstance(rows, list) or any(not isinstance(row, Mapping) for row in rows):
+            raise ProbeTaskError("MathQA sealed source rows are malformed")
+        if len(rows) != self.task_config.get("source_rows"):
+            raise ProbeTaskError("MathQA sealed source row count differs from authority")
+        self._set_verified_dataset([dict(row) for row in rows])
+
+    def _process_doc(self, row: Mapping[str, object], source_index: int):
+        if frozenset(row) != _SCHEMA:
+            raise ProbeTaskError("MathQA row schema is invalid")
+        correct = row.get("correct")
+        if not isinstance(correct, str) or correct not in ("a", "b", "c", "d", "e"):
+            raise ProbeTaskError("MathQA correct label is invalid")
+        return self._render_doc(
+            question=row.get("Problem"),
+            choices=self._options(row.get("options")),
+            gold="abcde".index(correct),
+            stable_id=f"mathqa:test:{source_index:05d}",
+            source_index=source_index,
+        )
+
+    @staticmethod
+    def _options(value: object) -> list[str]:
+        if not isinstance(value, str):
+            raise ProbeTaskError("MathQA options must be text")
+        if value.lstrip().startswith("["):
+            try:
+                encoded = ast.literal_eval(value)
+            except (SyntaxError, ValueError) as error:
+                raise ProbeTaskError("MathQA options are malformed") from error
+            if not isinstance(encoded, list) or len(encoded) != 5:
+                raise ProbeTaskError("MathQA options are malformed")
+            result = []
+            for index, choice in enumerate(encoded):
+                prefix = f"{'abcde'[index]} ) "
+                result.append(
+                    choice[len(prefix) :] if isinstance(choice, str) and choice.startswith(prefix) else ""
+                )
+            return result
+        if not value.startswith(_OPTION_MARKERS[0]):
+            raise ProbeTaskError("MathQA options are malformed")
+        options: list[str] = []
+        cursor = len(_OPTION_MARKERS[0])
+        for marker in _OPTION_MARKERS[1:]:
+            boundary = value.find(f", {marker}", cursor)
+            if boundary < 0:
+                raise ProbeTaskError("MathQA options are malformed")
+            options.append(value[cursor:boundary])
+            cursor = boundary + len(marker) + 2
+        options.append(value[cursor:])
+        return options
