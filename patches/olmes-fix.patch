@@ -0,0 +1,518 @@
+"""Read one sealed probe source without importing the parent project.
+
+The materializer writes this cache; OLMES only verifies and consumes it.  This
+module deliberately has no datasets or project-package imports so a deployed
+OLMES tree can validate the same immutable source boundary in isolation.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from collections.abc import Mapping
+from dataclasses import dataclass
+from pathlib import Path, PurePosixPath
+import re
+import stat
+from typing import Any
+
+
+_MANIFEST_NAME = "probe_source_cache_manifest.json"
+_EXECUTION_RECEIPT_FIELDS = {
+    "kind",
+    "schema_version",
+    "materialization_request",
+    "source_cache_root",
+    "release_identities",
+    "authorities",
+}
+_EXECUTION_AUTHORITY_NAMES = {
+    "project_deployment",
+    "project_runtime",
+    "evaluator",
+    "source_manifest",
+    "materialization_request",
+    "stage_handoff",
+    "source_cache",
+}
+_SHA256 = re.compile(r"[0-9a-f]{64}\Z")
+_BLOB = re.compile(r"[0-9a-f]{40}\Z")
+_PROBE = re.compile(r"[a-z0-9][a-z0-9._-]*\Z")
+_CHUNK_SIZE = 1024 * 1024
+
+
+class ProbeSourceFileError(ValueError):
+    """Raised when an OLMES probe source cache is not exact and sealed."""
+
+
+@dataclass(frozen=True)
+class VerifiedProbeSource:
+    """Verified source bytes and the authority identity that sealed them."""
+
+    probe_id: str
+    logical_path: str
+    source_path: Path
+    payload: bytes
+    sha256: str
+    size_bytes: int
+    authority_receipt_path: str
+
+
+def load_verified_probe_source(task_config: Mapping[str, object]) -> VerifiedProbeSource:
+    """Load the one cache leaf authorized by a probe task configuration."""
+
+    root_value = os.environ.get("PROBE_SOURCE_CACHE_ROOT")
+    if not root_value:
+        raise ProbeSourceFileError("PROBE_SOURCE_CACHE_ROOT is required")
+    root = Path(root_value)
+    if not root.is_absolute():
+        raise ProbeSourceFileError("PROBE_SOURCE_CACHE_ROOT must be absolute")
+    _require_directory(root, "probe source cache root")
+    probe_id, scope = _task_scope(task_config)
+    binding = _mapping(scope.get("source_input_file"), "source input binding")
+    manifest = _json_object(_read_regular(root / _MANIFEST_NAME, "cache manifest"), "cache manifest")
+    cache_authority = _mapping(task_config.get("source_cache_authority"), "source cache authority")
+    authority_root = _validate_manifest(root, manifest, probe_id, cache_authority)
+    sources = _mapping(manifest.get("sources"), "cache sources")
+    entry = _mapping(sources.get(probe_id), f"cache source {probe_id}")
+    logical_path, expected_sha, expected_size = _validate_entry(entry, probe_id, binding)
+    source_path = _source_path(root, _string(entry.get("cache_path"), "cache path"))
+    payload = _read_regular(source_path, f"cached source {probe_id}")
+    observed_sha = hashlib.sha256(payload).hexdigest()
+    observed_blob = _git_blob(payload)
+    if len(payload) != expected_size or observed_sha != expected_sha:
+        raise ProbeSourceFileError(f"cached source bytes differ: {probe_id}")
+    if entry.get("observed_size_bytes") != len(payload) or entry.get("observed_sha256") != observed_sha:
+        raise ProbeSourceFileError(f"cached source receipt differs: {probe_id}")
+    if _blob(entry.get("observed_git_blob_id"), "observed Git blob") != observed_blob:
+        raise ProbeSourceFileError(f"cached source Git blob differs: {probe_id}")
+    authority = _mapping(entry.get("authority_receipt"), "authority receipt")
+    _validate_authority_receipt(authority_root, authority, probe_id, scope)
+    return VerifiedProbeSource(
+        probe_id=probe_id,
+        logical_path=logical_path,
+        source_path=source_path,
+        payload=payload,
+        sha256=observed_sha,
+        size_bytes=len(payload),
+        authority_receipt_path=_safe_receipt_path(authority),
+    )
+
+
+def parse_strict_json(payload: bytes, label: str) -> object:
+    """Parse a source JSON payload while rejecting duplicate and non-finite values."""
+
+    return _json(payload, label)
+
+
+def _task_scope(task_config: Mapping[str, object]) -> tuple[str, Mapping[str, object]]:
+    probe_id = _string(task_config.get("probe_id"), "probe id")
+    if not _PROBE.fullmatch(probe_id):
+        raise ProbeSourceFileError("probe id is malformed")
+    scope = _mapping(task_config.get("population_authority_scope"), "population authority scope")
+    for name in ("source_id", "revision", "config", "split"):
+        if scope.get(name) != task_config.get(
+            {"source_id": "dataset_path", "config": "dataset_name"}.get(name, name)
+        ):
+            raise ProbeSourceFileError(f"population authority {name} differs from task")
+    _mapping(scope.get("source_input_file"), "source input binding")
+    return probe_id, scope
+
+
+def _validate_manifest(
+    root: Path,
+    manifest: Mapping[str, object],
+    probe_id: str,
+    cache_authority: Mapping[str, object],
+) -> Path:
+    expected_fields = {
+        "kind",
+        "schema_version",
+        "materialization_request",
+        "source_manifest",
+        "probe_order",
+        "release_identities",
+        "sources",
+    }
+    if (
+        set(manifest) != expected_fields
+        or manifest.get("kind") != "probe-source-cache"
+        or manifest.get("schema_version") != 1
+    ):
+        raise ProbeSourceFileError("probe source cache manifest is malformed")
+    source_manifest = _artifact_reference(
+        manifest.get("source_manifest"), "source manifest"
+    )
+    authority_sha = _sha256(source_manifest.get("sha256"), "source manifest sha256")
+    authority_root = _validate_role_tuple(
+        root, manifest, _mapping(manifest.get("release_identities"), "release identities"), authority_sha
+    )
+    order = manifest.get("probe_order")
+    sources = _mapping(manifest.get("sources"), "cache sources")
+    if not isinstance(order, list) or not order or any(not isinstance(item, str) for item in order):
+        raise ProbeSourceFileError("cache authority population order is malformed")
+    if len(order) != len(set(order)) or set(order) != set(sources) or probe_id not in sources:
+        raise ProbeSourceFileError("cache source roster differs from authority")
+    if (
+        cache_authority.get("authority_manifest_sha256") != authority_sha
+        or cache_authority.get("authority_population_order") != order
+    ):
+        raise ProbeSourceFileError("source cache authority differs from manifest")
+    source = _mapping(cache_authority.get("source"), "source cache authority source")
+    if source.get("probe_id") != probe_id:
+        raise ProbeSourceFileError("source cache authority probe differs")
+    entry = _mapping(sources[probe_id], f"cache source {probe_id}")
+    if (
+        source.get("logical_path") != entry.get("logical_path")
+        or source.get("expected_sha256") != entry.get("expected_sha256")
+        or source.get("expected_size_bytes") != entry.get("expected_size_bytes")
+    ):
+        raise ProbeSourceFileError("source cache authority source differs")
+    return authority_root
+
+
+def _validate_role_tuple(
+    root: Path,
+    manifest: Mapping[str, object],
+    identities: Mapping[str, object],
+    authority_sha: str,
+) -> Path:
+    expected_keys = {"executor_release", "coordinator_release", "input_producer_releases", "output_release"}
+    if set(identities) != expected_keys:
+        raise ProbeSourceFileError("cache release identities have an unexpected role")
+    input_roles = {
+        "executor_release": _blob(identities.get("executor_release"), "executor release"),
+        "coordinator_release": _blob(identities.get("coordinator_release"), "coordinator release"),
+        "input_producer_releases": _release_map(identities.get("input_producer_releases")),
+    }
+    expected_output = _derive_output_release(input_roles, authority_sha)
+    if _blob(identities.get("output_release"), "output release") != expected_output:
+        raise ProbeSourceFileError("cache output release is not derived")
+    return _validate_execution_receipt(root, manifest, identities)
+
+
+def _validate_execution_receipt(
+    root: Path, manifest: Mapping[str, object], identities: Mapping[str, object]
+) -> Path:
+    value = os.environ.get("PROBE_SOURCE_EXECUTION_RECEIPT")
+    if not value:
+        raise ProbeSourceFileError("PROBE_SOURCE_EXECUTION_RECEIPT is required")
+    receipt = Path(value)
+    if not receipt.is_absolute():
+        raise ProbeSourceFileError("execution role receipt path must be absolute")
+    payload = _json_object(_read_regular(receipt, "execution role receipt"), "execution role receipt")
+    if (
+        set(payload) != _EXECUTION_RECEIPT_FIELDS
+        or payload.get("kind") != "probe-source-execution"
+        or payload.get("schema_version") != 1
+    ):
+        raise ProbeSourceFileError("execution role receipt is malformed")
+    if payload.get("source_cache_root") != str(root.resolve()):
+        raise ProbeSourceFileError("execution role receipt cache root differs")
+    if payload.get("release_identities") != dict(identities):
+        raise ProbeSourceFileError("execution role receipt release identities differ")
+    authorities = _mapping(payload.get("authorities"), "execution role authorities")
+    if set(authorities) != _EXECUTION_AUTHORITY_NAMES:
+        raise ProbeSourceFileError("execution role authority roster differs")
+    for name, record in authorities.items():
+        checked = _artifact_reference(record, f"execution role authority {name}")
+        observed = _file_authority(
+            Path(_string(checked.get("path"), f"execution role authority {name} path")),
+            f"execution role authority {name}",
+        )
+        if dict(checked) != observed:
+            raise ProbeSourceFileError(f"execution role authority differs: {name}")
+    expected_manifest = _file_authority(root / _MANIFEST_NAME, "cache manifest")
+    if authorities.get("source_cache") != expected_manifest:
+        raise ProbeSourceFileError("execution role receipt cache manifest differs")
+    if payload.get("materialization_request") != authorities.get("materialization_request"):
+        raise ProbeSourceFileError("execution role receipt request differs")
+    if manifest.get("materialization_request") != authorities.get("materialization_request"):
+        raise ProbeSourceFileError("cache materialization request differs")
+    if manifest.get("source_manifest") != authorities.get("source_manifest"):
+        raise ProbeSourceFileError("execution role receipt source authority manifest differs")
+    source_manifest = _artifact_reference(authorities.get("source_manifest"), "source manifest")
+    authority_path = Path(_string(source_manifest.get("path"), "source manifest path"))
+    authority_root = authority_path.parent
+    _require_directory(authority_root, "source authority directory")
+    if authority_path.name != "source_manifest.json":
+        raise ProbeSourceFileError("source authority manifest path is malformed")
+    return authority_root
+
+
+def _artifact_reference(value: object, label: str) -> Mapping[str, object]:
+    record = _mapping(value, label)
+    if set(record) != {"path", "sha256", "byte_count"}:
+        raise ProbeSourceFileError(f"{label} fields differ")
+    path = _string(record.get("path"), f"{label} path")
+    if not Path(path).is_absolute():
+        raise ProbeSourceFileError(f"{label} path must be absolute")
+    _sha256(record.get("sha256"), f"{label} sha256")
+    _integer(record.get("byte_count"), f"{label} byte count")
+    return record
+
+
+def _file_authority(path: Path, label: str) -> dict[str, object]:
+    payload = _read_regular(path, label)
+    return {
+        "path": str(path.resolve()),
+        "sha256": hashlib.sha256(payload).hexdigest(),
+        "byte_count": len(payload),
+    }
+
+
+def _release_map(value: object) -> dict[str, str]:
+    mapping = _mapping(value, "input producer releases")
+    if not mapping or any(not name for name in mapping):
+        raise ProbeSourceFileError("input producer releases are malformed")
+    return {name: _blob(revision, f"input producer release {name}") for name, revision in mapping.items()}
+
+
+def _derive_output_release(releases: Mapping[str, object], authority_sha: str) -> str:
+    payload = json.dumps(
+        {
+            "source_manifest_sha256": authority_sha,
+            "coordinator_release": releases["coordinator_release"],
+            "executor_release": releases["executor_release"],
+            "input_producer_releases": releases["input_producer_releases"],
+        },
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    return hashlib.sha1(b"blob " + str(len(payload)).encode("ascii") + b"\0" + payload).hexdigest()
+
+
+def _validate_entry(
+    entry: Mapping[str, object], probe_id: str, binding: Mapping[str, object]
+) -> tuple[str, str, int]:
+    if entry.get("kind") not in {"direct", "zip-member"}:
+        raise ProbeSourceFileError(f"cache source kind is malformed: {probe_id}")
+    logical_path = _string(entry.get("logical_path"), "logical path")
+    _logical_path(logical_path)
+    source = _primary_source(binding)
+    expected_logical = _string(source.get("logical_path"), "authority logical path")
+    expected_sha, expected_size = _source_digest_fields(source)
+    if logical_path != expected_logical:
+        raise ProbeSourceFileError(f"cache logical path differs from authority: {probe_id}")
+    if entry.get("expected_sha256") != expected_sha or entry.get("expected_size_bytes") != expected_size:
+        raise ProbeSourceFileError(f"cache expected source differs from authority: {probe_id}")
+    _sha256(entry.get("observed_sha256"), "observed source sha256")
+    _integer(entry.get("observed_size_bytes"), "observed source size")
+    _blob(entry.get("observed_git_blob_id"), "observed Git blob")
+    if entry.get("kind") == "direct":
+        expected_blob = _blob(source.get("git_blob_id"), "authority Git blob")
+        if entry.get("expected_git_blob_id") != expected_blob:
+            raise ProbeSourceFileError(f"cache expected Git blob differs from authority: {probe_id}")
+    authority = _mapping(entry.get("authority_receipt"), "authority receipt")
+    _safe_receipt_path(authority)
+    _sha256(authority.get("sha256"), "authority receipt sha256")
+    _integer(authority.get("size_bytes"), "authority receipt size")
+    return logical_path, expected_sha, expected_size
+
+
+def _primary_source(binding: Mapping[str, object]) -> Mapping[str, object]:
+    if "qa_files" in binding:
+        return _mapping(_mapping(binding["qa_files"], "Bar Exam QA files").get("test"), "Bar Exam test source")
+    if "primary" in binding:
+        return _mapping(binding["primary"], "primary source")
+    return binding
+
+
+def _source_digest_fields(source: Mapping[str, object]) -> tuple[str, int]:
+    if "member_sha256" in source or "member_size_bytes" in source:
+        return _sha256(source.get("member_sha256"), "source member sha256"), _integer(
+            source.get("member_size_bytes"), "source member size"
+        )
+    return _sha256(source.get("sha256"), "source sha256"), _integer(source.get("size_bytes"), "source size")
+
+
+def _source_path(root: Path, relative: str) -> Path:
+    parts = _relative_parts(relative, "cache source path")
+    if len(parts) != 2 or parts[0] != "sources":
+        raise ProbeSourceFileError("cache source path is unsafe")
+    path = root.joinpath(*parts)
+    _contained_regular(root, path, "cached source")
+    return path
+
+
+def _safe_receipt_path(authority: Mapping[str, object]) -> str:
+    path = _string(authority.get("path"), "authority receipt path")
+    _relative_parts(path, "authority receipt path")
+    return path
+
+
+def _validate_authority_receipt(
+    authority_root: Path,
+    authority: Mapping[str, object],
+    probe_id: str,
+    task_scope: Mapping[str, object],
+) -> None:
+    """Cross-bind one cached source to its sealed population authority receipt."""
+
+    relative = _safe_receipt_path(authority)
+    receipt_path = authority_root.joinpath(*_relative_parts(relative, "authority receipt path"))
+    _contained_regular(authority_root, receipt_path, "authority receipt")
+    receipt_bytes = _read_regular(receipt_path, "authority receipt")
+    if hashlib.sha256(receipt_bytes).hexdigest() != _sha256(
+        authority.get("sha256"), "authority receipt sha256"
+    ) or len(receipt_bytes) != _integer(authority.get("size_bytes"), "authority receipt size"):
+        raise ProbeSourceFileError("authority receipt differs from cache")
+    manifest_path = authority_root / "source_manifest.json"
+    manifest = _json_object(
+        _read_regular(manifest_path, "source authority manifest"),
+        "source authority manifest",
+    )
+    if (
+        manifest.get("kind") != "probe-population-manifest-index"
+        or manifest.get("schema_version") != 1
+        or manifest.get("status") != "population_approved"
+    ):
+        raise ProbeSourceFileError("source authority manifest is malformed")
+    order = manifest.get("population_order")
+    if (
+        not isinstance(order, list)
+        or not order
+        or any(not isinstance(item, str) for item in order)
+        or len(order) != len(set(order))
+        or manifest.get("population_count") != len(order)
+        or probe_id not in order
+    ):
+        raise ProbeSourceFileError("source authority manifest population differs")
+    documents = _mapping(manifest.get("document_sha256"), "source authority manifest document hashes")
+    if documents.get(relative) != hashlib.sha256(receipt_bytes).hexdigest():
+        raise ProbeSourceFileError("authority receipt is absent from source manifest")
+    receipt = _json_object(receipt_bytes, "authority receipt")
+    if (
+        receipt.get("probe_id") != probe_id
+        or receipt.get("kind") != "probe-population-manifest"
+        or receipt.get("schema_version") != 1
+        or receipt.get("status") != "population_approved"
+    ):
+        raise ProbeSourceFileError("authority receipt probe or status differs")
+    binding = _mapping(receipt.get("source_binding"), "authority receipt source binding")
+    for field in ("source_id", "revision", "config", "split", "source_input_file"):
+        if binding.get(field) != task_scope.get(field):
+            raise ProbeSourceFileError("authority receipt source binding differs")
+
+
+def _contained_regular(root: Path, path: Path, label: str) -> None:
+    try:
+        path.relative_to(root)
+    except ValueError as error:
+        raise ProbeSourceFileError(f"{label} escapes cache root") from error
+    parent = root
+    for part in path.relative_to(root).parts[:-1]:
+        parent = parent / part
+        _require_directory(parent, f"{label} parent")
+    _read_regular(path, label)
+
+
+def _require_directory(path: Path, label: str) -> None:
+    try:
+        state = path.lstat()
+    except OSError as error:
+        raise ProbeSourceFileError(f"{label} is missing") from error
+    if path.is_symlink() or not stat.S_ISDIR(state.st_mode):
+        raise ProbeSourceFileError(f"{label} must be a real directory")
+
+
+def _read_regular(path: Path, label: str) -> bytes:
+    try:
+        state = path.lstat()
+    except OSError as error:
+        raise ProbeSourceFileError(f"{label} is missing") from error
+    if path.is_symlink() or not stat.S_ISREG(state.st_mode):
+        raise ProbeSourceFileError(f"{label} must be a regular non-symlink file")
+    flags = os.O_RDONLY | os.O_CLOEXEC
+    if hasattr(os, "O_NOFOLLOW"):
+        flags |= os.O_NOFOLLOW
+    try:
+        descriptor = os.open(path, flags)
+    except OSError as error:
+        raise ProbeSourceFileError(f"{label} cannot be opened without following links") from error
+    try:
+        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
+            raise ProbeSourceFileError(f"{label} must be regular")
+        chunks: list[bytes] = []
+        while chunk := os.read(descriptor, _CHUNK_SIZE):
+            chunks.append(chunk)
+        return b"".join(chunks)
+    finally:
+        os.close(descriptor)
+
+
+def _json_object(payload: bytes, label: str) -> dict[str, object]:
+    parsed = _json(payload, label)
+    if not isinstance(parsed, dict):
+        raise ProbeSourceFileError(f"{label} must be a JSON object")
+    return parsed
+
+
+def _json(payload: bytes, label: str) -> object:
+    def no_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, object]:
+        result: dict[str, object] = {}
+        for key, value in pairs:
+            if key in result:
+                raise ProbeSourceFileError(f"{label} has duplicate JSON key {key!r}")
+            result[key] = value
+        return result
+
+    def no_constant(value: str) -> object:
+        raise ProbeSourceFileError(f"{label} has non-finite JSON value {value}")
+
+    try:
+        parsed = json.loads(payload.decode("utf-8"), object_pairs_hook=no_duplicates, parse_constant=no_constant)
+    except ProbeSourceFileError:
+        raise
+    except (UnicodeDecodeError, json.JSONDecodeError) as error:
+        raise ProbeSourceFileError(f"{label} is not strict JSON") from error
+    return parsed
+
+
+def _relative_parts(value: str, label: str) -> tuple[str, ...]:
+    pure = PurePosixPath(value)
+    if pure.is_absolute() or not pure.parts or any(part in {"", ".", ".."} for part in pure.parts):
+        raise ProbeSourceFileError(f"{label} is unsafe")
+    return pure.parts
+
+
+def _logical_path(value: str) -> None:
+    for component in value.split("::"):
+        _relative_parts(component, "logical path")
+
+
+def _mapping(value: object, label: str) -> Mapping[str, object]:
+    if not isinstance(value, Mapping) or any(not isinstance(key, str) for key in value):
+        raise ProbeSourceFileError(f"{label} must be an object")
+    return value
+
+
+def _string(value: object, label: str) -> str:
+    if not isinstance(value, str) or not value:
+        raise ProbeSourceFileError(f"{label} must be nonempty text")
+    return value
+
+
+def _integer(value: object, label: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise ProbeSourceFileError(f"{label} must be a nonnegative integer")
+    return value
+
+
+def _sha256(value: object, label: str) -> str:
+    value = _string(value, label)
+    if not _SHA256.fullmatch(value):
+        raise ProbeSourceFileError(f"{label} is malformed")
+    return value
+
+
+def _blob(value: object, label: str) -> str:
+    value = _string(value, label)
+    if not _BLOB.fullmatch(value):
+        raise ProbeSourceFileError(f"{label} is malformed")
+    return value
+
+
+def _git_blob(payload: bytes) -> str:
+    return hashlib.sha1(f"blob {len(payload)}\0".encode("ascii") + payload).hexdigest()
