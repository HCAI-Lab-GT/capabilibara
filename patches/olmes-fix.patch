+        "split": "test",
+    }
+
+    def download(self, data_dir=None, cache_dir=None, download_mode=None):
+        del data_dir, cache_dir, download_mode
+        source = self._verified_source()
+        if source.logical_path != "data/all/test.csv":
+            raise ProbeTaskError("CaseHOLD sealed source path is invalid")
+        try:
+            raw_rows = list(csv.reader(StringIO(source.payload.decode("utf-8"))))
+        except UnicodeDecodeError as error:
+            raise ProbeTaskError("CaseHOLD sealed CSV is not UTF-8") from error
+        if not raw_rows:
+            raise ProbeTaskError("CaseHOLD sealed source rows differ from authority")
+        rows = [
+            {
+                "example_id": row[0],
+                "citing_prompt": row[1],
+                "holding_0": row[2],
+                "holding_1": row[3],
+                "holding_2": row[4],
+                "holding_3": row[5],
+                "holding_4": row[6],
+                "label": row[12],
+            }
+            for row in raw_rows[1:]
+            if len(row) == 13
+        ]
+        if len(rows) != len(raw_rows) - 1 or len(rows) != self.task_config.get("source_rows"):
+            raise ProbeTaskError("CaseHOLD sealed source rows differ from authority")
+        for row in rows:
+            try:
+                row["example_id"] = int(row["example_id"])
+            except (TypeError, ValueError) as error:
+                raise ProbeTaskError("CaseHOLD example_id is invalid") from error
+        self._set_verified_dataset([dict(row) for row in rows])
+
+    def _process_doc(self, row: Mapping[str, object], source_index: int):
+        if frozenset(row) != _SCHEMA:
+            raise ProbeTaskError("CaseHOLD row schema is invalid")
+        example_id = row.get("example_id")
+        label = row.get("label")
+        if isinstance(example_id, bool) or not isinstance(example_id, int) or example_id < 0:
+            raise ProbeTaskError("CaseHOLD example_id is invalid")
+        if not isinstance(label, str) or label not in ("0", "1", "2", "3", "4"):
+            raise ProbeTaskError("CaseHOLD label is invalid")
+        return self._render_doc(
+            question=row.get("citing_prompt"),
+            choices=[row.get(f"holding_{index}") for index in range(5)],
+            gold=int(label),
+            stable_id=f"casehold:test:{example_id}",
+            source_index=source_index,
+            metadata={"example_id": example_id},
