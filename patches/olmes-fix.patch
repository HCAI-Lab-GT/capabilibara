+def _canonical_sha256(value: object) -> str:
+    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _mapping(value: object, label: str) -> Mapping[str, object]:
+    if not isinstance(value, Mapping):
+        raise ProbePopulationAuthorityError(f"{label} must be a mapping")
+    return value
+
+
+def _records(value: object, label: str) -> list[object]:
+    if not isinstance(value, list):
+        raise ProbePopulationAuthorityError(f"{label} must be a list")
+    for index, record in enumerate(value):
+        _mapping(record, f"{label} record {index}")
+    return value
+
+
+def _validate_records_digest(*, label: str, manifest: Mapping[str, object], records: Sequence[object]) -> None:
+    count = manifest.get("count")
+    expected = manifest.get("records_sha256")
+    if (
+        isinstance(count, bool)
+        or not isinstance(count, int)
+        or count != len(records)
+        or not isinstance(expected, str)
+        or len(expected) != 64
+    ):
+        raise ProbePopulationAuthorityError(f"{label} records manifest differs")
+    if _canonical_sha256(records) != expected:
+        raise ProbePopulationAuthorityError(f"{label} records digest differs")
+
+
+def _validate_config_integrity(alias: str, config: Mapping[str, object]) -> None:
+    manifests = _mapping(
+        config.get("authorized_exclusion_manifests"),
+        f"{alias} authorized exclusion manifests",
+    )
+    authorized = _records(config.get("authorized_exclusions"), f"{alias} authorized exclusions")
