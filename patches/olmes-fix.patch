+        if record.get("category") not in _CATEGORIES:
+            raise ProbePopulationAuthorityError(f"{alias} authorized exclusion category differs")
+    for category in _CATEGORIES:
+        manifest = _mapping(manifests.get(category), f"{alias} {category} manifest")
+        records = [
+            {key: value for key, value in record.items() if key != "category"}
+            for raw_record in authorized
+            if (record := _mapping(raw_record, f"{alias} {category} record")).get("category") == category
+        ]
+        _validate_records_digest(label=f"{alias} {category}", manifest=manifest, records=records)
+
+    sensitivities = _records(config.get("population_sensitivities"), f"{alias} population sensitivities")
+    for index, raw_sensitivity in enumerate(sensitivities):
+        sensitivity = _mapping(raw_sensitivity, f"{alias} population sensitivity {index}")
+        difference = _mapping(
+            sensitivity.get("difference_from_primary"),
+            f"{alias} population sensitivity {index} difference",
+        )
+        records = _records(
+            difference.get("records"),
+            f"{alias} population sensitivity {index} members",
+        )
+        _validate_records_digest(
+            label=f"{alias} population sensitivity {index}",
+            manifest=difference,
+            records=records,
+        )
+
